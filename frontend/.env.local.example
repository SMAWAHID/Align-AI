# ─── API ─────────────────────────────────────────────────────────────────────
# Base URL of the FastAPI backend (used by Next.js rewrites in production)
NEXT_PUBLIC_API_URL=http://localhost:8000

# ─── Feature Flags ────────────────────────────────────────────────────────────
# Show the history panel on the landing page
NEXT_PUBLIC_SHOW_HISTORY=true

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=AlignAI
NEXT_PUBLIC_MAX_FILE_SIZE_MB=10
