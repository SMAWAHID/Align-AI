# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://syedmawahid:passs@localhost:5432/alignai_db

# ─── AI Provider ─────────────────────────────────────────────────────────────
# "auto"     → uses Gemini if GEMINI_API_KEY is set, else Jina+Groq
# "gemini"   → force Gemini
# "fallback" → force Jina+Groq
AI_PROVIDER=auto

# ─── Gemini (primary — paid) ──────────────────────────────────────────────────
# Get key: https://aistudio.google.com/
# Leave blank to use the free fallback automatically
GEMINI_API_KEY=AIzaSyCxDfRT7C8erHBgM4rW7n4vw_vkS30B9-M

# ─── Jina AI (free embeddings fallback) ──────────────────────────────────────
# Free tier: 1,000,000 tokens/month — no credit card required
# Get key:  https://jina.ai/embeddings  → "Get API Key"
JINA_API_KEY=your_jina_api_key_here

# ─── Groq (free generation fallback) ─────────────────────────────────────────
# Free tier: very generous rate limits, llama-3.3-70b-versatile
# Get key:  https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# ─── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000

# ─── Security ─────────────────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=10
MAX_RESUME_PAGES=50
MAX_JD_LENGTH=20000

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_ANALYZE=10/minute
RATE_LIMIT_HISTORY=30/minute

# ─── App ──────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
