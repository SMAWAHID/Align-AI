# Normalize all text files to LF in the repo, CRLF on Windows checkout
* text=auto eol=lf

# Force these to always be LF (scripts break with CRLF)
*.py    text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.mjs   text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.css   text eol=lf
*.env*  text eol=lf
*.txt   text eol=lf

# Binaries — no line ending conversion
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.zip   binary